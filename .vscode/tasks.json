{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PawnKit: check",
            "type": "process",
            "command": "pawn",
            "args": ["check", "--project", "${workspaceFolder}"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "PawnKit: lint",
            "type": "process",
            "command": "pawn",
            "args": ["lint", "--project", "${workspaceFolder}"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "PawnKit: diagnose",
            "type": "process",
            "command": "pawn",
            "args": ["doctor", "--project", "${workspaceFolder}"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "sampctl: build",
            "type": "process",
            "command": "sampctl",
            "args": ["build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "runOptions": {
                "instanceLimit": 1,
                "reevaluateOnRerun": true
            },
            "isBackground": false,
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true,
                "revealProblems": "always",
                "focus": false
            },
            "problemMatcher": "$sampctl"
        },
        {
            "label": "sampctl: run",
            "type": "process",
            "command": "sampctl",
            "args": ["run"],
            "group": "build",
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": "$sampctl"
        }
    ]
}
