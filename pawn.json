{
	"user": "Southclaws",
	"repo": "ScavengeSurvive",
	"entry": "gamemodes/ScavengeSurvive.pwn",
	"output": "gamemodes/ScavengeSurvive.amx",
	"preset": "openmp",
	"local": true,
	"dependencies": [
		"openmultiplayer/omp-stdlib",
		"pawn-lang/samp-stdlib@open.mp",
		"pawn-lang/pawn-stdlib@open.mp",
		"sampctl/samp-stdutil",
		"Southclaws/samp-nolog:0.2.1",
		"Southclaws/samp-logger",
		"Southclaws/pawn-errors",
		"Y-Less/sscanf:v2.13.8",
		"samp-incognito/samp-streamer-plugin:v2.9.6",
		"pawn-lang/YSI-Includes@5.x",
		"Southclaws/formatex",
		"oscar-broman/strlib",
		"Southclaws/pawn-chrono:1.1.1",
		"Southclaws/progress2",
		"Southclaws/samp-ini",
		"Southclaws/samp-whirlpool:v1.0.0",
		"AmyrAhmady/samp-plugin-crashdetect:v4.22",
		"oscar-broman/sqlitei",
		"oscar-broman/md-sort",
		"Southclaws/modio",
		"ScavengeSurvive/personal-space",
		"ScavengeSurvive/action-text:1.0.1",
		"ScavengeSurvive/button@feat/pawnkit",
		"ScavengeSurvive/item@feat/pawnkit",
		"ScavengeSurvive/door",
		"ScavengeSurvive/inventory@feat/pawnkit",
		"ScavengeSurvive/container@feat/pawnkit",
		"ScavengeSurvive/item-array-data",
		"ScavengeSurvive/container-dialog@feat/pawnkit",
		"ScavengeSurvive/inventory-dialog@feat/pawnkit",
		"ScavengeSurvive/craft@feat/pawnkit",
		"Southclaws/pawn-fsutil:1.3.0",
		"Southclaws/samp-weapon-data",
		"Southclaws/samp-linegen",
		"Southclaws/samp-zipline",
		"Southclaws/samp-ladders"
	],
	"build": {
		"compiler": {
			"user": "pawn-lang",
			"repo": "compiler",
			"version": "3.10.10"
		},
		"constants": {
			"SAMP_COMPAT": ""
		},
		"args": [
			"-;+",
			"-(+",
			"-\\+",
			"-d3",
			"-Z+"
		],
		"includes": [
			"legacy"
		]
	},
	"runtime": {
		"bind": "0.0.0.0",
		"port": 7777,
		"rcon_password": "scavenge",
		"hostname": "Southclaws' Scavenge and Survive",
		"extra": {
			"long_call_time": "0"
		}
	},
	"pawnkit": {
		"schemaVersion": 1,
		"dependencyOverrides": {
			"Misiur/YSI-Includes": "pawn-lang/YSI-Includes@5.x",
			"BigETI/pawn-memory": "BigETI/pawn-memory:2.0.1",
			"ScavengeSurvive/mathutil": "ScavengeSurvive/mathutil#c7da0b5e056ef08456e8b0521164a6e2eac963c7",
			"ScavengeSurvive/tick-difference": "ScavengeSurvive/tick-difference:1.0.0",
			"Zeex/amx_assembly": "Zeex/amx_assembly#66ca1f13ffb83923cdba3e6ad2855a516d484ee6"
		}
	}
}
